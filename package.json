{
  "name": "focus-orbit",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve focus-orbit",
    "build": "ng build focus-orbit",
    "build:priority-map": "ng build priority-map",
    "build:all": "npm run build:priority-map && npm run build",
    "watch": "ng build focus-orbit --watch --configuration development",
    "pack:priority-map": "npm run build:priority-map && npm pack ./dist/priority-map"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "ng-packagr": "^22.0.0",
    "typescript": ">=6.0.0 <6.1.0"
  }
}
